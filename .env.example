# Normally generated by ./setup.sh. To do it by hand: cp .env.example .env

# --- Database (internal, not exposed) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rag

# --- n8n ---
# Generate with: openssl rand -hex 24
# Keep it: n8n uses it to encrypt saved credentials.
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_value
N8N_PORT=5678
GENERIC_TIMEZONE=America/Bogota

# --- Admin account created automatically on first start ---
# Leave OWNER_PASSWORD empty to create the account yourself in the web UI.
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=change_me
OWNER_FIRST_NAME=Demo
OWNER_LAST_NAME=RAG

# --- OpenAI (embeddings + chat model) ---
# After changing it: docker compose up -d --force-recreate n8n
OPENAI_API_KEY=
