# Copy to .env and change the values:  cp .env.example .env
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rag

# Generate with: openssl rand -hex 24
# Keep it: n8n uses it to encrypt saved credentials.
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_value

N8N_PORT=5678
GENERIC_TIMEZONE=America/Bogota
